# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini API (Server-side voice & text parsing)
GEMINI_API_KEY=your-gemini-api-key

# Application URL
APP_URL=https://dejz.se

# Enable Banking Feature Flag (Frontend)
# Keep false while Production is in Restricted mode (limits access to admin account only)
VITE_ENABLE_BANKING_PUBLIC=false

# Enable Banking Server Secrets (Set ONLY in Supabase Edge Function Secrets, NEVER in VITE_ or GitHub):
# ENABLE_BANKING_APP_ID=your-production-application-id
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ENABLE_BANKING_REDIRECT_URL=https://dejz.se/bank/callback
# ENABLE_BANKING_SANDBOX_APP_ID=your-sandbox-application-id
# ENABLE_BANKING_SANDBOX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ENABLE_BANKING_ALLOW_ALL_USERS=false
