    "@google/genai": "^2.32.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "11.9.0",
    "@supabase/supabase-js": "^2.39.7",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.7.15",
    "lucide-react": "^0.344.0",
    "motion": "^11.0.0",
    "path": "^0.12.7",
    "puppeteer": "^25.11.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
