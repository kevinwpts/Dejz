  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "snapshot": "git add -A && git commit -m \"manual snapshot\" --allow-empty",
    "lint": "node scripts/lint-design-system.js && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test src/utils/__tests__/*.test.ts",
    "e2e": "playwright test",
    "ios:build": "vite build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:assets": "npx capacitor-assets generate --ios"
  },
